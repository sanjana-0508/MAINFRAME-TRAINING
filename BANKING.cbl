IDENTIFICATION DIVISION.
PROGRAM-ID.BANKING.
AUTHOR.JU.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 BALANCE PIC 9(7)V99.
01 N PIC 9(5).
01 COUNT-VALUE PIC 9(5) VALUE 0.
01 ACCEPTED PIC 9(5) VALUE 0.
01 REJECTED PIC 9(5) VALUE 0.
01 TRANSACTION-ID PIC X(9).
01 TYPE-VALUE PIC X.
01 AMOUNT PIC 9(7)V99.
01 SUCCESSFUL-TRANS-AMOUNT PIC 9(7)V99 VALUE 0.
01 EXPECTED-COUNT PIC 9(5).
01 EXPECTED-AMOUNT PIC 9(7)V99.

PROCEDURE DIVISION.

    DISPLAY "OPENING BALANCE:"
    ACCEPT BALANCE

    DISPLAY "NO OF TRANSACTIONS:"
    ACCEPT N

    PERFORM UNTIL COUNT-VALUE >= N

       DISPLAY "TRANSACTION ID:"
       ACCEPT TRANSACTION-ID

       DISPLAY "TYPE (C/D):"
       ACCEPT TYPE-VALUE

       DISPLAY "AMOUNT:"
       ACCEPT AMOUNT

       IF AMOUNT > 0

          IF TYPE-VALUE = "C"
             ADD AMOUNT TO BALANCE
             ADD AMOUNT TO SUCCESSFUL-TRANS-AMOUNT
             ADD 1 TO ACCEPTED
             DISPLAY TRANSACTION-ID "VALID"

          ELSE
             IF TYPE-VALUE = "D"
                IF AMOUNT <= BALANCE
                   SUBTRACT AMOUNT FROM BALANCE
                   ADD AMOUNT TO  SUCCESSFUL-TRANS-AMOUNT
                   ADD 1 TO ACCEPTED
                   DISPLAY TRANSACTION-ID " VALID"
                ELSE
                   ADD 1 TO REJECTED
                   DISPLAY TRANSACTION-ID " REJECTED"
                END-IF
             ELSE
                ADD 1 TO REJECTED
                DISPLAY TRANSACTION-ID " REJECTED"
             END-IF
          END-IF

       ELSE
          ADD 1 TO REJECTED
          DISPLAY TRANSACTION-ID " REJECTED"
       END-IF

       ADD 1 TO COUNT-VALUE

    END-PERFORM

    DISPLAY "EXPECTED RECORD COUNT:"
    ACCEPT EXPECTED-COUNT

    DISPLAY "EXPECTED  SUCCESSFUL TRANSACTION AMOUNT:"
    ACCEPT EXPECTED-AMOUNT

    DISPLAY "FINAL BALANCE: " BALANCE
    DISPLAY "ACCEPTED: " ACCEPTED
    DISPLAY "REJECTED: " REJECTED
    DISPLAY " SUCCESSFUL TRANSACTION AMOUNT: "  SUCCESSFUL-TRANS-AMOUNT

    IF N = EXPECTED-COUNT
       DISPLAY "RECORD COUNT: MATCH"
    ELSE
       DISPLAY "RECORD COUNT: MISMATCH"
    END-IF

    IF SUCCESSFUL-TRANS-AMOUNT = EXPECTED-AMOUNT
       DISPLAY "AMOUNT CONTROL: MATCH"
    ELSE
       DISPLAY "AMOUNT CONTROL: MISMATCH"
    END-IF

    STOP RUN.
